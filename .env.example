# Sepolia only during M0/M1. Commands load .env; shell values take precedence.
RPC_URL=
# Verify the market address at https://docs.nillion.com/blacklight/l1/contracts
# This is a comparison value, not an address used to send calls.
EXPECTED_MARKET=
# Dedicated Sepolia signer for spike/settlement/researcher transaction commands. Never pass as a flag.
# Self-funded researcher CLI: must match the public researcher address in the recovery file.
# For the sponsored proof this payer covers all costs; the script generates an unfunded synthetic author.
AUTHOR_KEY=
# Tune for your provider's maximum eth_getLogs block span.
RPC_LOG_BLOCK_RANGE=10

# Public Reown project identifier for header wallet connections; safe for the browser.
# Add the application's origin to the project's Reown dashboard allowlist.
# This is not an author key or an RPC credential. Restart dev/rebuild after changing.
PROJECT_ID=

# Native portal development server. Public HTTPS origin is served through a TLS proxy.
PORTAL_ORIGIN=
# Existing absolute directory owned by the service user, mode 700; SQLite files are private.
PORTAL_DATA_DIR=
PORT=8080
PRIVATE_RETENTION_DAYS=90
# Compiled DisclosureRegistry deployment and its first block; comparison/routing values
# are supplied operationally and never committed as deployment literals.
REGISTRY_ADDRESS=
REGISTRY_FIRST_BLOCK=
MARKET_FIRST_BLOCK=
# Explicitly public, credential-free HTTPS browser RPC. Never copy a private RPC API key here.
PUBLIC_RPC_URL=
# Explicit operator opt-in for Sepolia browser posting and portal sponsorship.
# Requires validated RPC, compiled registry and a separately public browser RPC.
# Does not enable mainnet, bypass cost/consent checks or send at startup.
SEPOLIA_SUBMISSIONS=false
# Optional loopback origin for Next development. Staff intake requires the HTTPS portal.
DEV_ORIGIN=http://localhost:3000
# Optional dedicated Sepolia payer for private sponsorship request/funding review.
# This configures the payer; SEPOLIA_SUBMISSIONS controls actual submission.
RELAYER_KEY=
MAX_CEILING_WEI=
